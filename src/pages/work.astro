---
import Layout from '../components/Layout.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import SideProjects from '../components/SideProjects.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { experience, jobTitle } from '../data/resume';

const current = experience.find((e) => e.current);
const description = current
  ? `${site.author.name} — ${current.role} at ${current.company}.`
  : `${site.author.name} — ${jobTitle}. Work experience and background.`;
---

<Layout title="Work" description={description} image="/img/og.jpg">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>{site.author.name}</h1>
      <p class="muted" style="margin: 0 0 0.25rem;">
        {current ? `${current.role} · ${current.company}` : jobTitle}
      </p>
      {site.author.location && <p class="muted" style="margin: 0 0 0.25rem;">{site.author.location}</p>}
      <div style="margin: 1rem 0 0.5rem;">
        <SocialLinks />
      </div>
    </div>
  </section>

  <Experience />

  <Skills />

  <SideProjects />

  <Education />
</Layout>
