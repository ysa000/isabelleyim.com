---
import ThemeToggle from './ThemeToggle.astro';
import { site, withBase } from '../data/site';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  ...(site.features.travel ? [{ href: '/travel', label: 'Travel' }] : []),
].map((l) => ({ ...l, href: withBase(l.href) }));

const isCurrent = (href: string) =>
  href === withBase('/') ? Astro.url.pathname === href : Astro.url.pathname.startsWith(href);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={withBase('/')}>
      <span aria-hidden="true">&gt;</span> {site.shortTitle}
      <span>_</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>
