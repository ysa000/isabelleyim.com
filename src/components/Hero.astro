---
import { typingRoles, intro, jobTitle } from '../data/resume';
import { site, withBase } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const rolesJson = JSON.stringify(typingRoles);
const nameParts = site.author.name.split(' ');
const firstName = nameParts.shift() ?? '';
const lastName = nameParts.join(' ');
---

<section class="hero">
  <div class="stars" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div>
      <p class="hero-greeting">Hello, I'm</p>
      <h1>{firstName} {lastName && <span class="accent">{lastName}</span>}</h1>
      <p class="print-only hero-print-title">{jobTitle}</p>
      <p class="hero-typed">
        <span class="visually-hidden">{typingRoles.join(', ')}</span>
        <span class="typed-stage" aria-hidden="true">
          {/* Invisible copies of every role share one grid cell with the live line, so the
              box is always as tall as the longest role at the current width: no layout shift. */}
          {typingRoles.map((role) => <span class="typed-sizer">{role}▍</span>)}
          <span class="typed-live"><span class="typed" id="typed-roles" data-roles={rolesJson}>{typingRoles[0]}</span><span class="typed-cursor">▍</span></span>
        </span>
      </p>

      <p class="hero-bio">{intro}</p>

      <SocialLinks />

    </div>

    <img class="hero-avatar" src={withBase('/img/avatar.jpg')} alt={`Portrait of ${site.author.name}`} width="220" height="220" />
  </div>
</section>

<script>
  // Tighten the margin under the typing line only when its reserved space wraps to 2+ lines.
  const typedLine = document.querySelector<HTMLElement>('.hero-typed');
  const typedStage = typedLine?.querySelector<HTMLElement>('.typed-stage');
  if (typedLine && typedStage && 'ResizeObserver' in window) {
    const update = () => {
      const lineHeight = parseFloat(getComputedStyle(typedLine).lineHeight);
      typedLine.classList.toggle('is-multiline', typedStage.getBoundingClientRect().height > lineHeight * 1.5);
    };
    new ResizeObserver(update).observe(typedStage);
    update();
  }

  const el = document.getElementById('typed-roles');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      // Split into code points so emoji are typed whole rather than as broken halves.
      const word = Array.from(roles[roleIndex]);
      if (!deleting) {
        charIndex++;
        el.textContent = word.slice(0, charIndex).join('');
        if (charIndex === word.length) {
          // A single role is typed once and left in place; several roles cycle.
          if (roles.length === 1) return;
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        charIndex--;
        el.textContent = word.slice(0, charIndex).join('');
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 35);
      }
    };

    if (roles.length > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = '';
      tick();
    }
  }
</script>
